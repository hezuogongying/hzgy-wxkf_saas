# ==========================================
# 微信客服SaaS服务配置文件示例
# ==========================================

# ===== 服务商配置 (必需) =====
# 从企业微信服务商后台获取
SUITE_ID=your_suite_id
SUITE_SECRET=your_suite_secret
PROVIDER_SECRET=your_provider_secret
PROVIDER_TOKEN=your_provider_token
PROVIDER_ENCODING_AES_KEY=your_provider_encoding_aes_key

# ===== 服务器配置 =====
SERVER_URL=https://your-domain.com
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8083

# ===== 数据库配置 (必需) =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wxkf_saas
DB_USER=root
DB_PASSWORD=your_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ===== Redis配置 (推荐) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=wxkf_saas:

# ===== OpenAI配置 (可选，用于AI客服功能) =====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-3.5-turbo
OPENAI_SYSTEM_PROMPT=

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_FILE=

# ===== SaaS服务配置 =====
ENABLE_TENANT_ISOLATION=true
MAX_TENANTS=1000
TOKEN_CACHE_TTL=7000
