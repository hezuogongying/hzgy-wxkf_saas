# ==========================================
# 微信客服SaaS服务配置文件示例
# ==========================================

# ===== 服务商配置 (必需) =====
# 从企业微信服务商后台获取
SUITE_ID=your_suite_id
SUITE_SECRET=your_suite_secret
PROVIDER_SECRET=your_provider_secret
PROVIDER_TOKEN=your_provider_token
PROVIDER_ENCODING_AES_KEY=your_provider_encoding_aes_key

# ===== 服务器配置 =====
SERVER_URL=https://your-domain.com
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8083

# ===== 数据库配置 (必需) =====
# 推荐直接配置数据库URL，避免重复配置
# MySQL格式: mysql+pymysql://user:password@host:port/database?charset=utf8mb4
# PostgreSQL格式: postgresql+psycopg2://user:password@host:port/database
# SQLite格式: sqlite:///path/to/database.db
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/wxkf_saas?charset=utf8mb4
ASYNC_DATABASE_URL=mysql+aiomysql://root:your_password@localhost:3306/wxkf_saas?charset=utf8mb4

# ===== Redis配置 (推荐) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=wxkf_saas:

# ===== JWT认证配置 (必需) =====
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== OpenAI配置 (可选，用于AI客服功能) =====
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-3.5-turbo
OPENAI_SYSTEM_PROMPT=你是一个专业的客服助手

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_FILE=

# ===== SaaS服务配置 =====
ENABLE_TENANT_ISOLATION=true
MAX_TENANTS=1000
TOKEN_CACHE_TTL=7000
