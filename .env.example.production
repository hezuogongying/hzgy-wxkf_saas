# ==========================================
# 微信客服SaaS服务配置文件示例（生产环境）
# ==========================================

# ===== 服务器配置 =====
SERVER_URL=https://wxkf.shoudu888.com
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=58083

# 服务商授权事件接收URL：https://your-domain.com/callback/provider
# 企业授权事件接收URL：https://your-domain.com/callback/suite

# ===== 数据库配置 (必需) =====
# 直接配置数据库URL
DATABASE_URL=mysql+pymysql://root:09c8922d763a7c21@localhost:3306/wxkf_saas?charset=utf8mb4
ASYNC_DATABASE_URL=mysql+aiomysql://root:09c8922d763a7c21@localhost:3306/wxkf_saas?charset=utf8mb4

# ===== Redis配置 (推荐) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=wxkf_saas:

# ===== OpenAI配置 (可选，用于AI客服功能) =====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-3.5-turbo
OPENAI_SYSTEM_PROMPT=

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_FILE=

# ===== SaaS服务配置 =====
ENABLE_TENANT_ISOLATION=true
MAX_TENANTS=1000
TOKEN_CACHE_TTL=7000

# ===========================================
# 单体模式配置 (单企业使用)
# ===========================================
# 企业ID，在企业微信管理后台"我的企业"页面查看
CORP_ID=ww4c543662478cf668
# 客服应用 Secret，在企业微信管理后台"应用管理 -> 客服 -> Secret"处查看
CORP_SECRET=GTIWWMwInC6EkclidNK8IPdx0amlPeJdtEFvya8XFxg
# 客服专用 Secret（可选，如果与通用SECRET不同）
# KF_SECRET=
# 回调URL
CORP_CALLBACK_URL=https://wxkf.shoudu888.com/callback/customer-service
# 回调Token
CORP_CALLBACK_TOKEN=KLNsSkfx9
# 回调加密密钥
CORP_CALLBACK_ENCODING_AES_KEY=wOoBhDpcsBEC1YlQrD768hPFufWAIkWXS7y1bsWAFtK

# ===== API 测试配置（可选） =====
