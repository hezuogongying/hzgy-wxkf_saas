# ==========================================
# 微信客服SaaS服务 - 多数据库配置示例
# ==========================================

# ===== 通用配置 =====
# 从以下数据库类型中选择一个: mysql, postgresql, sqlite
DB_TYPE=mysql

# ===== 服务商配置 (必需) =====
SUITE_ID=your_suite_id
SUITE_SECRET=your_suite_secret
PROVIDER_SECRET=your_provider_secret
PROVIDER_TOKEN=your_provider_token
PROVIDER_ENCODING_AES_KEY=your_provider_encoding_aes_key

# ===== 服务器配置 =====
SERVER_URL=https://your-domain.com
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8083

# ===== Redis配置 (推荐) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=wxkf_saas:

# ===== 数据库配置选项 =====

# === 选项1: MySQL ===
# 配置类型1: 使用环境变量
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wxkf_saas
DB_USER=wxkf_saas
DB_PASSWORD=wxkf_saas
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# 配置类型2: 直接配置URL（会覆盖上述参数）
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/wxkf_saas?charset=utf8mb4
ASYNC_DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/wxkf_saas?charset=utf8mb4

# === 选项2: PostgreSQL ===
# 配置类型1: 使用环境变量
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wxkf_saas
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# 配置类型2: 直接配置URL（会覆盖上述参数）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wxkf_saas
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wxkf_saas

# === 选项3: SQLite ===
# 配置类型1: 使用环境变量
DB_TYPE=sqlite
DB_PATH=./data/app.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# 配置类型2: 直接配置URL（会覆盖上述参数）
DATABASE_URL=sqlite:///./data/app.db
ASYNC_DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ===== 数据库连接池配置 =====
# 所有数据库类型通用
DB_POOL_SIZE=10          # 核心连接数
DB_MAX_OVERFLOW=20         # 最大额外连接数

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_FILE=

# ===== SaaS服务配置 =====
ENABLE_TENANT_ISOLATION=true
MAX_TENANTS=1000
TOKEN_CACHE_TTL=7000

# ===== SSL/TLS配置（可选） =====
# 生产环境HTTPS配置
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# ===== 文件上传配置 =====
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760  # 10MB

# ===== 回调URL配置（可选） =====
# 如果不配置，将基于SERVER_URL自动生成
CALLBACK_URL_PROVIDER=
CALLBACK_URL_SUITE=

# ===== OpenAI配置（可选） =====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-3.5-turbo
OPENAI_SYSTEM_PROMPT=